{
  "short_name": "KeepSpace",
  "name": "KeepSpace - Premium PWA Document Vault",
  "icons": [
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "start_url": "/",
  "background_color": "#0d0f12",
  "theme_color": "#09090b",
  "display": "standalone",
  "orientation": "portrait-primary",
  "description": "Premium secure document vault for PDFs, images, videos, and links built with Cloudflare D1 and R2.",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "application/pdf", "text/*", "*/*"]
        }
      ]
    }
  }
}
